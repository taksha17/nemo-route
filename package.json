{
  "name": "nemo-route",
  "private": true,
  "version": "0.1.0",
  "description": "NIM model router with availability tracking, failover, and dashboard",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @nemo-route/server dev",
    "dev:web": "pnpm --filter @nemo-route/web dev",
    "build": "pnpm -r run build",
    "test": "pnpm --filter @nemo-route/server test",
    "db:generate": "pnpm --filter @nemo-route/server db:generate",
    "db:migrate": "pnpm --filter @nemo-route/server db:migrate",
    "start": "pnpm --filter @nemo-route/server start"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0"
}
